<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <!-- 视频预览层：默认隐藏，避免 SurfaceView 黑屏遮挡 UI -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintBottom_toTopOf="@id/controlBar" />

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remotePreview"
        android:layout_width="140dp"
        android:layout_height="100dp"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEmptyHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:gravity="center"
        android:text="已加入房间\n1. 开启「人像抠图」可让接收端去掉背景\n2. 点击「开始投屏」推送摄像头\n3. 其他设备（电脑/全息端）会自动接收画面"
        android:textColor="#9CA3AF"
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintBottom_toTopOf="@id/controlBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.holographic.app.AngleGuideView
        android:id="@+id/angleGuideOverlay"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="@id/localPreview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#111827"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvRoomId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#10B981"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#111827"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSegmentation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开启人像抠图"
            android:textColor="#F3F4F6" />

        <Button
            android:id="@+id/btnStartCast"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="开始投屏"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 加入页放在最上层，确保不被 SurfaceView 遮挡 -->
    <ScrollView
        android:id="@+id/joinPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全息投影 · 手机端"
                android:textColor="#A78BFA"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="输入信令服务器与房间号"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:hint="信令服务器 (http://IP:端口)"
                android:text="http://124.220.4.69:9000"
                android:textColor="#F3F4F6"
                android:textColorHint="#6B7280"
                android:background="#1F2937"
                android:paddingHorizontal="12dp"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/etRoomId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:hint="房间号 (如 ABC123)"
                android:textColor="#F3F4F6"
                android:textColorHint="#6B7280"
                android:background="#1F2937"
                android:paddingHorizontal="12dp"
                android:inputType="textCapCharacters" />

            <Button
                android:id="@+id/btnJoinManual"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="加入房间" />

            <Button
                android:id="@+id/btnScanJoin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="扫码加入" />

            <Button
                android:id="@+id/btnCheckUpdate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="检查更新"
                android:textColor="#93C5FD" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
