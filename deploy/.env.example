# Docker Compose 环境变量
# 复制为 .env 并修改

# 信令
PORT=8765

# TURN（公网部署必填）
TURN_EXTERNAL_IP=YOUR_PUBLIC_IP
TURN_SECRET=holographic-turn-secret-change-me
TURN_USER=holo
TURN_PASS=holo123456

# 客户端构建时使用
VITE_SIGNALING_URL=http://YOUR_PUBLIC_IP:8765
VITE_TURN_URL=turn:YOUR_PUBLIC_IP:3478
VITE_TURN_USER=holo
VITE_TURN_PASS=holo123456
